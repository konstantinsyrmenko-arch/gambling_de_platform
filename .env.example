# Local development configuration template.
# Copy this file to .env and replace every CHANGE_ME value.
# Generate a separate value for each password:
#   openssl rand -base64 24
# Generate Airflow keys with the commands shown next to the variables.
# Never commit .env or reuse local credentials in production.

COMPOSE_PROJECT_NAME=homework-de
TZ=Europe/Moscow

AIRFLOW_UID=50000
AIRFLOW_VERSION=3.0.6
AIRFLOW_IMAGE=apache/airflow:3.0.6-python3.12
PYTHON_VERSION=3.12
INSTALL_DEV_DEPENDENCIES=true
AIRFLOW_EXTERNAL_PORT=8080
# Generate:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=CHANGE_ME
# Generate:
# openssl rand -hex 32
AIRFLOW_JWT_SECRET=CHANGE_ME

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
POSTGRES_EXTERNAL_PORT=5432

AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=CHANGE_ME

APP_DB_NAME=gaming
APP_DB_USER=gaming
APP_DB_PASSWORD=CHANGE_ME

METABASE_DB_NAME=metabase
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=CHANGE_ME
METABASE_EXTERNAL_PORT=3000

CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=analyst
CLICKHOUSE_PASSWORD=CHANGE_ME
CLICKHOUSE_HTTP_EXTERNAL_PORT=8123
CLICKHOUSE_NATIVE_EXTERNAL_PORT=9000

AIRFLOW_WORKER_CONCURRENCY=2
FLOWER_EXTERNAL_PORT=5555
